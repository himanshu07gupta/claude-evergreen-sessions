#!/usr/bin/env bash
# cc-pin: pick a pinned Claude Code session and resume it in the right folder.
#
#   cc-pin          interactive picker (uses fzf when installed)
#   cc-pin list     print pins
#   cc-pin <n|id>   resume pin number n, or the one whose id starts with <id>
#
# If cleanup deleted the original transcript, it is restored from the backup first.
set -euo pipefail

CONFIG="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
FILE="$CONFIG/pinned-sessions/pins.json"

command -v jq >/dev/null || { echo "cc-pin needs jq (brew install jq)" >&2; exit 1; }
[[ -s "$FILE" ]] || { echo "No pins yet. Run /pin inside a Claude Code session." >&2; exit 1; }

count=$(jq '.pins | length' "$FILE")
(( count > 0 )) || { echo "No pins yet. Run /pin inside a Claude Code session." >&2; exit 1; }

rows() {
  jq -r --arg home "$HOME" '.pins | to_entries[] |
    "\(.key + 1)\t📌 \(.value.title)\t\(.value.cwd | sub("^" + $home; "~"))\t\(.value.updatedAt[0:10])\t\(.value.id[0:8])"' "$FILE"
}

case "${1:-}" in
  list|-l|--list)
    rows | column -t -s $'\t'
    exit 0 ;;
  -h|--help)
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
esac

if [[ -n "${1:-}" ]]; then
  choice="$1"
elif command -v fzf >/dev/null; then
  choice=$(rows | fzf --delimiter=$'\t' --with-nth=2.. --prompt='resume 📌 ' --height=40% --reverse | cut -f1) || exit 0
else
  rows | column -t -s $'\t'
  echo
  read -r -p "Resume which pin? [1-$count] " choice
fi
[[ -n "$choice" ]] || exit 0

if [[ "$choice" =~ ^[0-9]+$ ]]; then
  pin=$(jq -c --argjson i "$((choice - 1))" '.pins[$i] // empty' "$FILE")
else
  pin=$(jq -c --arg p "$choice" '[.pins[] | select(.id | startswith($p))] | if length == 1 then .[0] else empty end' "$FILE")
fi
[[ -n "$pin" ]] || { echo "No single pin matches '$choice'. Try: cc-pin list" >&2; exit 1; }

field() { jq -r --arg k "$1" '.[$k] // ""' <<<"$pin"; }
id=$(field id); cwd=$(field cwd); transcript=$(field transcript); backup=$(field backup)

if [[ -n "$transcript" && ! -f "$transcript" && -f "$backup" ]]; then
  echo "Transcript was cleaned up; restoring it from the pin backup."
  mkdir -p "$(dirname "$transcript")"
  cp -p "$backup" "$transcript"
  sidecar_backup="${backup%.jsonl}"
  [[ -d "$sidecar_backup" ]] && cp -Rp "$sidecar_backup" "${transcript%.jsonl}"
  # Cleanup is keyed on mtime: mark the restored copy fresh so the next startup keeps it.
  touch "$transcript"
fi

[[ -d "$cwd" ]] || { echo "Folder $cwd no longer exists." >&2; exit 1; }
echo "Resuming 📌 $(field title)  ($cwd)"
cd "$cwd"
exec claude --resume "$id"
